{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "APP_URL",
    "AUTH_SECRET",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "API_KEY_PEPPER",
    "DATABASE_URL",
    "TOKEN_ENCRYPTION_KEY",
    "META_APP_SECRET",
    "META_APP_ID",
    "META_VERIFY_TOKEN",
    "INSTAGRAM_APP_ID",
    "INSTAGRAM_APP_SECRET",
    "INSTAGRAM_VERIFY_TOKEN",
    "WHATSAPP_VERIFY_TOKEN",
    "META_GRAPH_VERSION",
    "NEXT_PUBLIC_WHATSAPP_CONFIG_ID",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_WEBHOOK_URL",
    "NODE_ENV",
    "NEXT_PUBLIC_META_APP_ID",
    "NEXT_PUBLIC_META_CONFIG_ID",
    "ENVIRONMENT",
    "PUBLIC_BASE_URL",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "GITHUB_STEP_SUMMARY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".wrangler/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "cache": false,
      "persistent": true
    },
    "test:run": {
      "dependsOn": [
        "^test:run"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
