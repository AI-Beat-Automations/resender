{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env=\"\"",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env=\"\"",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types cloudflare-env.d.ts --config wrangler.jsonc --config ../api/wrangler.jsonc --env-file .dev.vars.example --env-interface CloudflareEnv",
    "cf-typegen:check": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types cloudflare-env.d.ts --config wrangler.jsonc --config ../api/wrangler.jsonc --env-file .dev.vars.example --env-interface CloudflareEnv --check",
    "lint": "eslint --ignore-pattern .next --ignore-pattern .open-next --ignore-pattern .wrangler --ignore-pattern apps --ignore-pattern cloudflare-env.d.ts .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@workspace/contracts": "*",
    "@workspace/ui": "*",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.31",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.408.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.114.0"
  }
}
