{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  // NO apunta a `.open-next/worker.js`: ese bundle solo exporta `fetch` y este
  // Worker necesita además `queue` y `scheduled`. `worker.ts` lo reexporta y
  // agrega los dos handlers al lado (patrón de custom worker de OpenNext).
  "main": "worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Ambos en false a propósito: con `workers_dev: true` el sitio entero
  // respondía 200 en web.<subdomain>.workers.dev — una copia idéntica e
  // indexable de resender.dev — y `preview_urls: true` publicaba una URL más
  // por deploy. Sin canonicals que consolidaran, eso partía la autoridad entre
  // varios hosts. Para smoke tests, `wrangler dev` o un preview puntual.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // `META_GRAPH_VERSION` la lee `lib/meta/graph-version.ts`, y de ahí sale la
  // base de **todas** las llamadas del cliente de WhatsApp. Va acá y no como
  // secreto porque no lo es: es la versión de la API con la que hablamos, y
  // tenerla en el repo es lo que permite verla en un diff cuando cambia.
  //
  // v26.0 para que coincida con la versión de los campos de webhook suscritos en
  // el App Dashboard: si la forma del payload que Meta manda y la de las
  // llamadas que hacemos se separan, los tipos nuevos entran como `unknown` en
  // vez de fallar, y eso se descubre tarde.
  //
  // Messenger e Instagram siguen con su `v23.0` inline en `lib/outbound/*` y en
  // `lib/meta.ts`: esta variable **no** los toca, a propósito, para que subir la
  // versión de un canal no arrastre a los otros dos.
  "vars": { "ENVIRONMENT": "production", "META_GRAPH_VERSION": "v26.0" },
  // Entrega durable al webhook del tenant. Las colas ya existen en la cuenta
  // (`docs/api-cloudflare-manual-runbook.md`), creadas cuando esto vivía en el
  // Worker `api`; acá se rebindean al Worker que sí está desplegado.
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_DELIVERIES",
        "queue": "webhook-deliveries",
      },
      {
        "binding": "WHATSAPP_JOBS",
        "queue": "whatsapp-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "webhook-deliveries",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "webhook-deliveries-dlq",
      },
      {
        // La DLQ tiene consumidor propio y reintentos distintos de cero a
        // propósito: no llama al webhook del cliente, solo marca el job `dead`.
        // Si esa escritura a la base falla, el mensaje tiene que volver, no
        // desaparecer. Ver `docs/api-dlq-runbook.md`.
        "queue": "webhook-deliveries-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
      },
      {
        // Cola propia y no `webhook-deliveries` a propósito: un import de
        // historial de Coexistence son miles de jobs, y en la cola de entregas
        // competirían en batches de 10 con los pushes de todos los tenants.
        "queue": "whatsapp-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "whatsapp-jobs-dlq",
      },
      {
        // Mismo criterio que la DLQ de entregas: consumidor propio para marcar
        // el job muerto, con reintentos porque esa escritura puede fallar.
        "queue": "whatsapp-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
      },
    ],
  },
  // Media **entrante** de WhatsApp. La URL que da Meta dura 5 minutos y el
  // media id 7 días, así que esta es la única copia. Privado y sin `r2.dev`: lo
  // que autoriza la descarga es la fila de `messages`, no el bucket.
  //
  // La retención de 180 días es una lifecycle rule del bucket, no código:
  // `wrangler r2 bucket lifecycle add whatsapp-media --prefix wa/ --expire-days 180`.
  "r2_buckets": [
    {
      "binding": "WHATSAPP_MEDIA",
      "bucket_name": "whatsapp-media",
    },
  ],
  // Recuperación: reclama los jobs cuyo plazo durable venció, es decir los que
  // quedaron `pending`/`processing` porque el Worker murió entre encolar y
  // entregar. Es la red debajo de la cola, no un segundo camino de entrega.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "observability": {
    "enabled": true,
    // Explícito aunque 1 ya sea el valor por defecto: el muestreo por cabecera
    // descarta la invocación entera, no líneas sueltas, y este worker es el que
    // atiende los webhooks de Meta. Dejarlo escrito evita que alguien lo baje
    // "para ahorrar" sin ver la consecuencia.
    "logs": { "enabled": true, "head_sampling_rate": 1 },
  },
  // Único host que sirve el worker. `www` NO va acá: debe resolverse con una
  // Redirect Rule 301 hacia el ápex (ver el checklist de Cloudflare), no
  // sirviendo el mismo contenido en dos dominios.
  "routes": [{ "pattern": "resender.dev", "custom_domain": true }],
  // Rate limit del formulario público de la lista de espera (ADR 0007), la
  // primera escritura anónima del repo. La clave es la IP del visitante, así
  // que el límite es por IP y no global: un evento entero detrás de un NAT
  // comparte cuota, y por eso no puede ser 1.
  // 5 envíos por minuto es holgado para una persona real —que manda uno, y como
  // mucho reintenta tras un error de validación— y corta un bot que barre la
  // ruta.
  "ratelimits": [
    {
      "name": "WAITLIST_RATE_LIMITER",
      // Entero positivo que tiene que ser único en la cuenta de Cloudflare:
      // 1001 y 1002 ya los usa `apps/api` (`apps/api/wrangler.jsonc:43`), así
      // que acá va 1003. Repetir un id haría que dos limiters compartieran
      // contador.
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Los secretos (DATABASE_URL, AUTH_SECRET, etc.) NO van aquí: se cargan con
  // `wrangler secret put <NAME>` en producción y en `.dev.vars` para preview local.

  "env": {
    // Worker separado `web-staging`, mismo código y distinto estado: branch de
    // Neon propia, llaves de test de Stripe y app de Meta de desarrollo. Se
    // despliega desde la rama `dev` (.github/workflows/deploy-staging.yml).
    //
    // Sobre la herencia: `main`, `compatibility_date`, `compatibility_flags`,
    // `assets`, `observability`, `workers_dev` y `preview_urls` SÍ se heredan
    // del bloque de arriba y por eso no se repiten. `vars`, `ratelimits`, los
    // bindings y los secretos NO se heredan y hay que declararlos completos.
    "staging": {
      "name": "web-staging",
      // `workers_dev`/`preview_urls` se heredan en false por la misma razón que
      // en producción: un host extra sirviendo el mismo HTML es contenido
      // duplicado indexable. Staging vive solo en su custom domain, y ese
      // hostname debe quedar detrás de Cloudflare Access (ver el checklist) —
      // si no, Google indexa una copia entera del sitio.
      "routes": [{ "pattern": "staging.resender.dev", "custom_domain": true }],
      // Faltaba, y wrangler lo venía avisando: `vars` no se hereda, así que
      // `web-staging` corría sin `ENVIRONMENT` y `logger.ts` lo resolvía como
      // `development` (`process.env.ENVIRONMENT ?? "development"`). Filtrar
      // `$.environment = "staging"` no devolvía nada, que es exactamente lo que
      // hace falta para verificar la cola y el cron acá.
      // `vars` no se hereda del entorno de arriba: hay que repetirla entera.
      "vars": { "ENVIRONMENT": "staging", "META_GRAPH_VERSION": "v26.0" },
      // Colas propias. Compartirlas con producción haría que un job de prueba
      // saliera hacia el webhook real de un cliente que paga.
      "queues": {
        "producers": [
          {
            "binding": "WEBHOOK_DELIVERIES",
            "queue": "webhook-deliveries-staging",
          },
          {
            "binding": "WHATSAPP_JOBS",
            "queue": "whatsapp-jobs-staging",
          },
        ],
        "consumers": [
          {
            "queue": "webhook-deliveries-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "webhook-deliveries-staging-dlq",
          },
          {
            "queue": "webhook-deliveries-staging-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
          },
          {
            "queue": "whatsapp-jobs-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "whatsapp-jobs-staging-dlq",
          },
          {
            "queue": "whatsapp-jobs-staging-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
          },
        ],
      },
      // Bucket propio y no el de producción: compartirlo haría que un job de
      // prueba tocara los archivos de un cliente que paga.
      "r2_buckets": [
        {
          "binding": "WHATSAPP_MEDIA",
          "bucket_name": "whatsapp-media-staging",
        },
      ],
      // Explícito aunque `triggers` sea heredable: staging es donde se verifica
      // que el cron corre, y depender de la herencia para eso deja la
      // verificación apoyada en un detalle de wrangler en vez de en el archivo.
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      // Contador propio: compartir `namespace_id` con producción haría que el
      // tráfico de pruebas consumiera la cuota de los visitantes reales.
      // 1001/1002 los usa `apps/api` y 1003 es `web` de producción.
      "ratelimits": [
        {
          "name": "WAITLIST_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      "observability": {
        "enabled": true,
      },
    },
  },
}
